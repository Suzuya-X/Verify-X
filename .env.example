# VerifyX Environment Configuration

# 1. Gemini Configuration (Required)
# Used for server-side multimodal document extraction
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Configuration (Required for Postgres Audit)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 3. Hyperledger Fabric Configuration (Optional / Local Dev)
# Set to 'true' to enable Blockchain anchoring
FABRIC_ENABLED=false

# Paths to the Test-Network crypto material
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=verifyx
FABRIC_MSP_ID=Org1MSP
FABRIC_CRYPTO_PATH=/path/to/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp
FABRIC_TLS_CERT_PATH=/path/to/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
